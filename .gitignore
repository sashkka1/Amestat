# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Пример без значений — единственный env-файл, который идёт в git.
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Внутренние документы работы — в git не идут (устав всех проектов владельца)
docs/
CLAUDE.md

# Supabase CLI: временные файлы локального окружения
supabase/.temp/
supabase/.branches/

# Сборщик: свои зависимости, журналы обходов и профили браузера — только на этом компьютере
collector/node_modules/
collector/logs/
collector/profile*/
