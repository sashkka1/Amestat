# Amestat — ключи. Настоящий файл — `.env.local`, он в git НЕ идёт (.gitignore: .env*).
# Заполнил → `npm run setup:supabase`. Значения в чат не копировать — только сюда.
#
# ОБЯЗАТЕЛЬНЫХ ТРИ: адрес, публичный ключ, ключ service_role. Остальное — замена кликам
# в панели: пусто — скрипт пропустит шаг и в конце напишет, что сделать руками.
#
# Проект в панели Supabase: New project → имя amestat → регион Central EU (Frankfurt).

# === ОБЯЗАТЕЛЬНО =========================================================================
# Project Settings → Data API → Project URL   (https://xxxxxxxxxxxxxxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=
# Project Settings → API Keys → Publishable key (sb_publishable_…)
#   или вкладка Legacy API keys → anon (eyJ…). Подходит любой из двух. Уходит в браузер.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Project Settings → API Keys → вкладка Legacy API keys → service_role (eyJ…, длинный).
#   Для сборщика в Sashboard. В браузер не попадает; NEXT_PUBLIC_ сюда не дописывать.
SUPABASE_SERVICE_ROLE_KEY=

# === ПО ЖЕЛАНИЮ: чтобы скрипт сделал за тебя то, что иначе кликается в панели ===========
# Личный токен + пароль базы → скрипт сам накатит миграции (иначе: SQL Editor, вставить
#   три файла supabase/migrations/*.sql по очереди).
#   Токен: аватар справа вверху → Account settings → Access Tokens → Generate new token.
#   Пароль базы — тот, что задал при создании проекта.
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
# Почта + пароль → скрипт заведёт пользователя сайта и впишет его в замок owners
#   (иначе: Authentication → Users → Add user, и одна строка SQL — в README).
AMESTAT_LOGIN_EMAIL=
AMESTAT_LOGIN_PASSWORD=

# Локально пусто. На GitHub Pages подставляет workflow (/Amestat).
NEXT_PUBLIC_BASE_PATH=
# Адрес сайта на Pages: с токеном уйдёт в Auth → Site URL и Redirect URLs.
AMESTAT_SITE_URL=https://sashkka1.github.io/Amestat/
