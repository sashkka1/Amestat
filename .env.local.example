# Amestat — ключи. Файл в git НЕ идёт (.gitignore: .env*). Заполни и скажи мне —
# дальше всё делает `npm run setup:supabase`: миграции, пользователь, замок owners,
# выключение регистрации, ключи для сборщика в Sashboard.
#
# Откуда брать — панель нового аккаунта Supabase, проект amestat:
#   Project Settings → API → Project URL, ключи anon (publishable) и service_role.
#   Пароль базы задаёшь при создании проекта (Project Settings → Database → Reset, если забыл).
#   Личный токен: https://supabase.com/dashboard/account/tokens → Generate new token.

# --- Сайт: уходят в браузер, публичные по замыслу ---------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Локально пусто. На GitHub Pages подставляет workflow (/Amestat).
NEXT_PUBLIC_BASE_PATH=

# --- Только для настройки и сборщика: в браузер не попадают. NEXT_PUBLIC_ сюда не дописывать
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
SUPABASE_ACCESS_TOKEN=

# --- Вход на сайт: этого пользователя заведу в Auth и впишу в owners ---------------------
AMESTAT_LOGIN_EMAIL=
AMESTAT_LOGIN_PASSWORD=

# --- Адрес сайта на Pages: уйдёт в Auth → Site URL и Redirect URLs ------------------------
AMESTAT_SITE_URL=https://sashkka1.github.io/Amestat/
