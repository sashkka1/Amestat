# Amestat — ключи. Настоящий файл — `.env.local`, он в git НЕ идёт (.gitignore: .env*).
# Заполнил → `npm run setup:supabase`. Значения в чат не копировать — только сюда.
#
# ОБЯЗАТЕЛЬНЫХ ТРИ: адрес, публичный ключ, ключ service_role. Остальное — замена кликам
# в панели: пусто — скрипт пропустит шаг и в конце напишет, что сделать руками.
#
# Проект в панели Supabase: New project → имя amestat → регион Central EU (Frankfurt).

# === ОБЯЗАТЕЛЬНО =========================================================================
# Project Settings → Data API → Project URL   (https://xxxxxxxxxxxxxxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=
# Project Settings → API Keys → Publishable key (sb_publishable_…)
#   или вкладка Legacy API keys → anon (eyJ…). Подходит любой из двух. Уходит в браузер.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Project Settings → API Keys → вкладка Legacy API keys → service_role (eyJ…, длинный).
#   Для сборщика в Sashboard. В браузер не попадает; NEXT_PUBLIC_ сюда не дописывать.
SUPABASE_SERVICE_ROLE_KEY=

# === ПО ЖЕЛАНИЮ: чтобы скрипт сделал за тебя то, что иначе кликается в панели ===========
# Личный токен + пароль базы → скрипт сам накатит миграции (иначе: SQL Editor, вставить
#   три файла supabase/migrations/*.sql по очереди).
#   Токен: аватар справа вверху → Account settings → Access Tokens → Generate new token.
#   Пароль базы — тот, что задал при создании проекта.
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
# Почта + пароль → скрипт заведёт пользователя сайта и впишет его в замок owners
#   (иначе: Authentication → Users → Add user, и одна строка SQL — в README).
AMESTAT_LOGIN_EMAIL=
AMESTAT_LOGIN_PASSWORD=

# Локально пусто. На GitHub Pages подставляет workflow (/Amestat).
NEXT_PUBLIC_BASE_PATH=
# Адрес сайта на Pages: с токеном уйдёт в Auth → Site URL и Redirect URLs.
AMESTAT_SITE_URL=https://sashkka1.github.io/Amestat/

# Хост пула соединений (IPv4): Project Settings → Database → Connection string → Session pooler,
#   часть после @ и до :5432. Прямой адрес базы у Supabase только по IPv6, без него не подключиться.
SUPABASE_POOLER_HOST=

# === СБОРЩИК (collector/) ================================================================
# Читает этот же файл. Подробности — collector/README.md.
#
# Чем водить браузер: пусто — Opera, если установлена, иначе Chrome.
#   Можно `opera`, `chrome` или полный путь к exe (версионный, не лаунчер!).
AMESTAT_BROWSER=
# Пауза между креаторами TikTok в секундах — то есть между запусками чистых профилей.
#   Пусто — 8. TikTok не любит запуски подряд; после креатора Instagram (браузер там общий на
#   весь обход) и после неудачи «профиль не найден» паузы нет вовсе.
#   ⚠️ Начнёт TikTok отвечать пустыми списками — это скажет замечание [list]; вот тогда больше.
AMESTAT_PAUSE_S=
# Через сколько минут повторять неудавшийся обход по расписанию. Пусто — 60.
#   Повтор один и только по неудавшимся креаторам; не помог — сообщение в Telegram.
AMESTAT_RETRY_MIN=

# Расписание автоматических обходов: часы через запятую по местному времени.
#   Пусто — ОДИН слот, 13:00 (владелец, 2026-09-09). Формат: `13` или `10,13,17`.
#   ⚠️ Слот пропускается, если сегодня до него уже завершился обход по ВСЕМ креаторам —
#   хоть по кнопке с сайта, хоть руками, хоть догоном. В логе и в журнале сайта это видно
#   строкой «слот 13:00 пропущен: сегодня уже был обход по всем в HH:MM».
AMESTAT_SLOTS=
# Глубина автоматического обхода (слот, догон, повтор): `all` — весь список видео,
#   `week` — только за последние 7 дней. Пусто — all («в ежедневном обновлении пусть всё
#   обновляется»). ⚠️ Обход «всё» занимает минуты — если станет долгим, ставится week именно здесь.
AMESTAT_SLOT_DEPTH=

# Защита TikTok по адресу: сколько раз подряд можно поднять ЧИСТЫЙ профиль (список видео
#   TikTok отдаёт только свежему профилю, поэтому запуск — на каждого креатора).
#   Пусто — 6 запусков за 15 минут; счёт общий на все процессы (файл collector/logs/tiktok-launches.json).
#   Окно кончилось — полоса TikTok ждёт, и это видно на сайте строкой «пауза TikTok до HH:MM».
AMESTAT_TT_LAUNCHES=
AMESTAT_TT_WINDOW_MIN=
# Через сколько минут сам собой повторяется РУЧНОЙ обход, который свалила защита по адресу.
#   Пусто — 25. Повтор один, только по неудавшимся креаторам, письма при назначении нет;
#   отменяется, если к сроку по тем креаторам уже прошёл удачный обход.
AMESTAT_MANUAL_RETRY_MIN=

# Комментарии (тексты, таблица video_comments). Собираются после снимков видео и только у
#   свежих роликов: на каждое видео открывается своя страница, и шаг стоит времени.
# За сколько последних дней брать видео. Пусто — 7.
AMESTAT_COMMENTS_DAYS=
# Потолок комментариев на одно видео. Пусто — 100.
AMESTAT_COMMENTS_MAX=
# Потолок ОТВЕТОВ под одним корневым комментарием. Пусто — 20. Ответы ложатся в ту же таблицу
#   video_comments с parent_id = id корневого; ветка раскрывается кликом и своим запросом,
#   поэтому потолок здесь свой, а не общий с корневыми.
AMESTAT_REPLIES_MAX=

# Охват «только наши» (миграция v17): сколько прокруток списка отпущено на поиск отслеживаемых
#   видео — наших (ours) и жёлтых (watch). Пусто — 30. При охвате «всё» переменная не при чём.
#   Дошли до потолка — остальные отслеживаемые считаются ненайденными: строка в лог
#   «не найдено N наших/жёлтых видео за 30 прокруток» и замечание [list].
#   ⚠️ Ставится больше, если у креатора наши видео лежат глубоко: список листается от новых к
#   старым, и до старого нашего надо докрутить. Подробности — collector/README.md, раздел
#   «Охват: всё или только наши».
AMESTAT_OURS_MAX_PAGES=

# Уведомления о проблемах в Telegram: в конце каждого обхода уходит одно сообщение со списком
#   замечаний, у каждого свой код в квадратных скобках ([creator], [stop], [comments] и так
#   далее — таблица в collector/README.md). Здесь перечисляются через запятую коды, которые
#   слать НЕ надо. Пусто — слать все.
#   Пример: AMESTAT_NOTIFY_MUTE=realtime,poll,images
AMESTAT_NOTIFY_MUTE=

# Instagram через официальный Graph API (приём Business Discovery).
#   Токен со страницы приложения Meta: аккаунт-бизнес + Instagram, права
#   instagram_basic и pages_read_engagement. Видит только Business/Creator-аккаунты.
IG_ACCESS_TOKEN=
# id нашего бизнес-аккаунта Instagram (числовой, от чьего имени спрашиваем чужие профили).
IG_USER_ID=
# Откуда брать Instagram: `graph` — официальный API, `web` — браузером (пока не настроено).
#   Пусто — graph, если есть токен, иначе web.
IG_SOURCE=

# Telegram: сборщик пишет владельцу, если обход по расписанию не удался и повтор через час тоже.
#   Токен — от @BotFather. Чат — id личной переписки владельца с ботом: сначала владелец пишет
#   боту любое сообщение, потом `node collector/telegram.mjs --chat-id --save` подставит id сам.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
